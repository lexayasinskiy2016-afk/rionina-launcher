{
  "name": "rionina-launcher",
  "productName": "Rionina Launcher",
  "version": "1.8.3",
  "description": "Rionina Launcher — Minecraft Java & Bedrock launcher in Apple style",
  "main": "src/main.js",
  "author": "Rionina",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "release": "node scripts/release.js",
    "site": "node scripts/build-site.js"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "msmc": "^5.0.5"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^25.1.8",
    "skinview3d": "^3.4.2"
  },
  "build": {
    "appId": "com.rionina.launcher",
    "productName": "Rionina Launcher",
    "directories": {
      "output": "dist"
    },
    "publish": null,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Rionina Launcher",
      "runAfterFinish": true,
      "installerLanguages": [
        "ru_RU"
      ],
      "language": "1049",
      "artifactName": "RioninaLauncher-Setup-${version}.${ext}",
      "uninstallDisplayName": "Rionina Launcher",
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.games",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game",
      "icon": "build/icon.png"
    }
  },
  "rionina": {
    "updateRepo": "lexayasinskiy2016-afk/rionina-launcher"
  }
}
